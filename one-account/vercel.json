{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "outputDirectory": "public",
  "functions": {
    "api/send-code.js": { "maxDuration": 30 },
    "api/teams.js": { "maxDuration": 30 },
    "api/history.js": { "maxDuration": 30 },
    "api/dashboard.js": {
      "includeFiles": "private/dashboard.enc",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/api/app" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
